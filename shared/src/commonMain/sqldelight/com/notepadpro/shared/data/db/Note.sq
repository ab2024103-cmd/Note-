CREATE TABLE note (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    lines_json TEXT NOT NULL,
    is_pinned INTEGER NOT NULL DEFAULT 0,
    source_path TEXT,
    line_ending TEXT NOT NULL DEFAULT 'LF',
    created_at INTEGER NOT NULL,
    modified_at INTEGER NOT NULL
);

CREATE INDEX note_modified_idx ON note(modified_at);

selectAll:
SELECT * FROM note ORDER BY is_pinned DESC, modified_at DESC;

searchByTitleOrContent:
SELECT * FROM note
WHERE title LIKE '%' || :query || '%' OR lines_json LIKE '%' || :query || '%'
ORDER BY is_pinned DESC, modified_at DESC;

selectById:
SELECT * FROM note WHERE id = ?;

insertNote:
INSERT INTO note(title, lines_json, is_pinned, source_path, line_ending, created_at, modified_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateNote:
UPDATE note
SET title = ?, lines_json = ?, is_pinned = ?, source_path = ?, line_ending = ?, modified_at = ?
WHERE id = ?;

deleteNote:
DELETE FROM note WHERE id = ?;

setPinned:
UPDATE note SET is_pinned = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
